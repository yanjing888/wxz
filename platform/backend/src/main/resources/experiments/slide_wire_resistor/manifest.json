        {
          "key": "voltage_V",
          "label": "接入部分电压",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "V",
          "min": 0
        },
        {
          "key": "current_mA",
          "label": "回路电流",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "mA",
          "min": 1e-06
        }
      ]
    },
    "3": {
      "title": "空载与带载分压测量",
      "guidePath": "steps/3.md",
      "correctionMode": "data",
