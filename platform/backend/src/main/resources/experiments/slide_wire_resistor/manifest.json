        {
          "key": "unloaded_voltage_V",
          "label": "空载输出电压",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "V",
          "min": 0
        },
        {
          "key": "loaded_voltage_V",
          "label": "带载输出电压",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "V",
          "min": 0
        },
        {
          "key": "load_resistance_ohm",
          "label": "负载电阻",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "Ω",
          "min": 1e-06
        }
      ]
    },
    "4": {
      "title": "特性曲线与接法比较",
      "guidePath": "steps/4.md",
      "correctionMode": "data",
      "dataSource": "manual",
      "imageRequired": true,
      "assessmentRequired": true,
      "assessmentBlocking": false,
      "assessmentMaxScore": 20,
      "assessmentCriteria": [
        "绘制位置–接入电阻、位置–输出电压曲线",
