        {
          "key": "conclusion",
          "label": "负载效应与接法比较",
          "type": "text",
          "required": true,
          "photoAssist": false
        }
      ]
    },
    "5": {
      "title": "实验结束与资料整理",
      "guidePath": "steps/5.md",
      "correctionMode": "vision",
      "dataSource": "manual",
      "imageRequired": true,
      "assessmentRequired": true,
      "assessmentBlocking": false,
      "assessmentMaxScore": 20,
      "assessmentCriteria": [
        "按现场规程停机或关闭光源、电源，将调节机构恢复安全位置",
        "整理原始记录、数据表格和过程照片，检查报告所需信息并清理台面",
        "原始记录、单位与过程证据清楚"
      ]
    }
  },
  "reportGuidePath": "report-guide.md"
