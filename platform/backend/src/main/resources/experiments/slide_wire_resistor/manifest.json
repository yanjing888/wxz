        "原始记录、单位与过程证据清楚"
      ],
      "dataFields": [
        {
          "key": "resistance_ohm",
          "label": "计算接入电阻",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "Ω",
          "min": 0
