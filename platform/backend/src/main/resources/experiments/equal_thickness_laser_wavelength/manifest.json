        {
          "key": "wavelength_nm",
          "label": "激光波长",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "nm",
          "min": 1e-06
        }
      ]
    },
    "5": {
      "title": "实验结束与资料整理",
      "guidePath": "steps/5.md",
