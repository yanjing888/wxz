          "required": true,
          "photoAssist": false,
          "unit": "mm"
        },
        {
          "key": "end_reading_mm",
          "label": "位移机构终点读数",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "unit": "mm"
        },
        {
          "key": "fringe_count",
          "label": "通过参考线的条纹数 N",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "min": 1
        }
      ]
    },
    "4": {
      "title": "波长计算与误差分析",
      "guidePath": "steps/4.md",
      "correctionMode": "data",
      "dataSource": "manual",
      "imageRequired": true,
      "assessmentRequired": true,
      "assessmentBlocking": false,
      "assessmentMaxScore": 20,
      "assessmentCriteria": [
        "将机构读数差换算为镜面实际位移 Δd",
        "按 λ≈2",
        "Δd",
        "/N 求波长并换算为 nm，分析漏计、回程间隙和倾角误差",
