        {
          "key": "spectral_line",
          "label": "所用谱线或波长",
          "type": "text",
          "required": true,
          "photoAssist": false
        }
      ]
    },
    "4": {
      "title": "折射率与测角误差分析",
      "guidePath": "steps/4.md",
      "correctionMode": "data",
      "dataSource": "manual",
      "imageRequired": true,
      "assessmentRequired": true,
      "assessmentBlocking": false,
      "assessmentMaxScore": 20,
      "assessmentCriteria": [
        "用实际光线夹角代入最小偏向角公式，计算前统一角度制",
        "报告双游标平均方法、重复测量离散及谱线判读误差",
