    "5": {
      "title": "实验结束与资料整理",
      "guidePath": "steps/5.md",
      "correctionMode": "vision",
      "dataSource": "manual",
      "imageRequired": true,
      "assessmentRequired": true,
      "assessmentBlocking": false,
      "assessmentMaxScore": 20,
      "assessmentCriteria": [
