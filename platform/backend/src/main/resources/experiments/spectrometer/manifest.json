      ],
      "dataFields": [
        {
          "key": "refractive_index",
          "label": "棱镜折射率",
          "type": "number",
          "required": true,
          "photoAssist": false,
          "min": 1
        },
        {
          "key": "angle_analysis",
          "label": "双游标与跨零处理说明",
          "type": "text",
          "required": true,
          "photoAssist": false
