# 物小智 Dify 配置（唯一入口，与 config/ports.env 同级）
# 修改后请用 scripts\run-backend.bat 或 scripts\start.bat 重启后端（会读取本文件注入环境变量）。
# Spring Boot 不能直接 import .env 文件，请勿仅双击 IDE 运行而未加载本配置。
#
# DIFY_BASE_URL     Dify 服务地址（所有接口共用，不变）
# DIFY_API_KEY      默认 API Key（文字问答、视觉纠错等）
# DIFY_WF_*         各工作流独立 Key（留空则回退 DIFY_API_KEY / text-assist）
# DIFY_WF_*_MODE    单个应用调用模式覆盖；Workflow 应用填 workflow

DIFY_BASE_URL=http://188.18.66.215/v1
DIFY_APP_MODE=chat

# 默认 Key（实验工作台 AI 助手 / 视觉纠错等）
DIFY_API_KEY=app-01LooqFQIENoqkysAnTW6PZa

# 实验工作台
DIFY_WF_VISION_CORRECTION=
DIFY_WF_TEXT_ASSIST=app-YkjVZc8dEp5rUK7OtArMID9E
DIFY_WF_ENV_CHECK=app-lj67G7bwbcq1Pi0i67IM6gks
DIFY_WF_ENV_CHECK_MODE=workflow
DIFY_WF_REPORT_GENERATE=

# 学生端智能体（按实验流程四阶段划分；留空则回退括号内的备选 Key）
# 第一期 P0 建议优先配置：INSTRUMENT_READING / DATA_DOCTOR / REPORT_ASSIST / REPORT_REVIEW
# ① 课前预习（第二期）
DIFY_WF_PRE_LAB=
# 器材清单核对：输出 JSON {items:[{name,spec,purpose,checkPoint,bySelf}]}（回退 PRE_LAB）
DIFY_WF_EQUIPMENT_CHECK=
# 预习自测：建议 Workflow 类型，输出结构化 JSON（题干/选项/答案/解析）
DIFY_WF_PRACTICE_QUIZ=
# 预习报告：按目的/原理/仪器/步骤/数据表/注意事项六段生成（回退 PRE_LAB）
DIFY_WF_PREP_REPORT=
# ② 实验操作（P0）
# 读数助手：必须是支持图片输入的多模态 Chatflow
DIFY_WF_INSTRUMENT_READING=
# ③ 数据处理（P0：DATA_DOCTOR）
# 数据表识别：多模态，输出 JSON {headers,rows,warnings}（回退 INSTRUMENT_READING）
DIFY_WF_DATA_ENTRY=
DIFY_WF_DATA_DOCTOR=
DIFY_WF_DATA_LAB=
DIFY_WF_ERROR_TRACE=
# ④ 实验报告（P0：REPORT_ASSIST / 教师 REPORT_REVIEW）
# REPORT_ASSIST 对应 docs/dify/wuxiaozhi-report-analysis-rich.yml，可同时服务学生端报告润色、完整性检查与复盘建议。
DIFY_WF_REPORT_ASSIST=
# 思考题助手：只给思路不代写（回退 REPORT_ASSIST）
DIFY_WF_THINK_QUESTIONS=
DIFY_WF_LAB_RECAP=
# 拓展（建议挂知识库）
DIFY_WF_EXPLORE=
# 教师端（P0）
DIFY_WF_REPORT_REVIEW=

# 知识库检索（留空=使用 text-assist / DIFY_API_KEY）
DIFY_KB_API_KEY=
DIFY_KB_TOP_K=5
# 在 Dify 创建双库后填写 dataset UUID（导入 docs/kb/export/ 中的文档）
DIFY_KB_TEACHING_DATASET_ID=
DIFY_KB_CORRECTION_RULES_DATASET_ID=
