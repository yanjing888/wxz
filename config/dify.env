# 物小智 Dify 配置（唯一入口，与 config/ports.env 同级）
# 修改后请用 scripts\run-backend.bat 或 scripts\start.bat 重启后端。
#
# 留空的工作流 Key 会按 application.yml 中的回退链使用 DIFY_API_KEY / text-assist。
# 状态可通过 GET /api/system/dify-status 查看。

DIFY_BASE_URL=http://188.18.66.215/v1
DIFY_APP_MODE=chat

# 默认 Key（各工作流未单独配置时的最终回退）
DIFY_API_KEY=app-oOI3v1A1XSlpoeW96RRs15CI

# ── 已上线 ──────────────────────────────────────────────
# 实验台主问答（文字指导 + 上传图片视觉纠错，同一 Chatflow）
DIFY_WF_TEXT_ASSIST=app-oOI3v1A1XSlpoeW96RRs15CI
# 可选：单独 Key；留空则与 text-assist 共用
DIFY_WF_VISION_CORRECTION=

# 环境巡检（Workflow，独立应用）
DIFY_WF_ENV_CHECK=app-lj67G7bwbcq1Pi0i67IM6gks
DIFY_WF_ENV_CHECK_MODE=workflow

# ── 预留：学生端 · 课前预习（ai-tools: pre-lab 等）────────
DIFY_WF_PRE_LAB=
DIFY_WF_EQUIPMENT_CHECK=
DIFY_WF_PRACTICE_QUIZ=
DIFY_WF_PREP_REPORT=


# ── 预留：学生端 · 实验报告（report-assist / think-questions / lab-recap）
# report-assist 配置步骤见 docs/dify/SETUP-REPORT-ASSIST-WORKFLOW.md
DIFY_WF_REPORT_GENERATE=
DIFY_WF_REPORT_ASSIST=app-RpvQUpXHEbqbYkawgi8szii3
DIFY_WF_THINK_QUESTIONS=
DIFY_WF_LAB_RECAP=

# ── 教师端 · 报告分析（report-review，TeacherService 调用）
# 导入 docs/dify/物小智-教师报告预评.yml 后，把发布得到的 API Key 填到这里。
# 配置步骤见 docs/dify/SETUP-REPORT-REVIEW-WORKFLOW.md
# 留空时教师端「AI 预评」会提示未接入，不会再回退到学生报告助手。
DIFY_WF_REPORT_REVIEW=app-8bAWdbCrtGBPYHkuWvx5fVZn

# ── 预留：拓展学习（explore / 原理答疑）──────────────────
DIFY_WF_EXPLORE=

# ── 知识库 Dataset Retrieve（留空则使用 DIFY_API_KEY）────
DIFY_KB_API_KEY=
DIFY_KB_TOP_K=5
# 在 Dify 创建双库后填写 UUID（docs/kb/export/）
DIFY_KB_TEACHING_DATASET_ID=
DIFY_KB_CORRECTION_RULES_DATASET_ID=
