# 物小智服务端口配置（唯一入口）

BACKEND_PORT=8082
FRONTEND_PORT=5174
UVC_CAMERA_PORT=8765
UVC_CAMERA_NAME_KEYWORD=UVC

# 实验台摄像头（实验室有线网 / WiFi 可达时用）
BENCH_CAMERA_IP=188.18.31.195

# 电脑与摄像头网线直连时的摄像头 IP（常与上面相同）
# 直连前请把电脑网卡设为同网段静态 IP，例如 188.18.31.100 / 255.255.255.0
BENCH_CAMERA_IP_DIRECT=188.18.31.195

# 连接模式: auto=先实验室网再试直连 | lab=仅实验室网 | direct=仅直连
BENCH_CAMERA_MODE=auto
