# 复制为 lab.properties。Windows/Linux、源码启动和正式 JAR 均自动读取。
# Java properties 使用 UTF-8；不要将实际账号、密码提交到版本库。
# 工位名称、摄像头地址和启用状态在管理端配置，保存到数据库。

# 旧 /ws/ 播放路径的服务器端目标（仅填写主机或 主机:端口，不含协议）。
wuxiaozhi.lab.camera-host=
wuxiaozhi.lab.camera-direct-host=
# 可选的首次登记设备来源；也可直接在管理端填写视频流地址。
# 推荐完整的 ws(s):// 或 http(s):// FLV 地址；RTSP 需由视频服务转成 FLV。
wuxiaozhi.lab.initial-stream-url=
# 仅在同型号摄像头有统一播放路径时配置。填写 IP 的工位会按此规则生成视频流地址。
# 例如当前联调设备使用 ws://{host}/ws/hdl/hlsram/live0.flv，其他型号请查实际路径。
wuxiaozhi.lab.ip-stream-template=
# 可选：明确开启后，启动时首次登记上述设备；重启不会覆盖现有设备。
wuxiaozhi.lab.bootstrap-enabled=false
# wuxiaozhi.lab.bootstrap-room-name=物理楼302
# wuxiaozhi.lab.bootstrap-station-code=01
# 抓拍仅用于 AI 巡检，没有 JPEG 地址仍可看视频；请勿猜测设备抓拍接口。
wuxiaozhi.lab.initial-snapshot-url=
wuxiaozhi.lab.camera-username=
wuxiaozhi.lab.camera-password=

# 停用旧的全局单摄像头入口，统一使用工位巡视。
wuxiaozhi.bench-camera.enabled=false
# 不使用读数用 UVC 成像相机时关闭；它和工位巡视摄像头是两套设备。
wuxiaozhi.uvc-camera.enabled=false

# 首次部署填写；仅在数据库没有管理员时创建，不会重置已有账号密码。
# WXZ_ADMIN_USERNAME=your-admin
# WXZ_ADMIN_PASSWORD=replace-with-a-strong-password
# wuxiaozhi.jwt.secret=replace-with-at-least-32-random-characters

# 正式学校部署建议启用 MySQL；也可通过 MYSQL_* 环境变量提供连接配置。
# spring.profiles.active=mysql
# spring.datasource.url=jdbc:mysql://127.0.0.1:3306/wuxiaozhi?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# spring.datasource.username=wuxiaozhi
# spring.datasource.password=replace-with-database-password
# server.port=8082
